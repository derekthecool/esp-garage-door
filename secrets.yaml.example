# Copy to secrets.yaml and fill in real values.
# secrets.yaml is gitignored — never commit it.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# 32-byte base64. Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# Hex string. Generate with: openssl rand -hex 16
ota_password: "REPLACE_WITH_HEX_PASSWORD"

# Password for the fallback AP if WiFi fails (min 8 chars).
fallback_ap_password: "REPLACE_WITH_FALLBACK_PASSWORD"
